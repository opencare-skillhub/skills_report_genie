# Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ============================================
# 核心系统配置
# ============================================

# Google Gemini API Key
GOOGLE_API_KEY=your_api_key_here


# SiliconFlow API Configuration
SILICONFLOW_API_KEY=your_siliconflow_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-OCR

# EdgeOne Pages API
EDGEONE_API_KEY=your-edgeone-api-key-here
EDGEONE_API_URL=https://api.edgeone.ai/pages

# ============================================
# 邮件服务配置
# ============================================

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your-email@example.com
SENDER_PASSWORD=your-app-specific-password

# ============================================
# PubMed API配置
# ============================================

PUBMED_API_KEY=your-pubmed-api-key
PUBMED_EMAIL=your-email@example.com

# ============================================
# Memos API配置
# ============================================

MEMOS_API_KEY=your-memos-api-key
MEMOS_CHANNEL=MEMOS
MEMOS_USER_ID=your-user-id

# ============================================
# Metaso API配置
# ============================================

METASO_API_KEY=your-metaso-api-key
METASO_API_URL=https://metaso.cn/api/mcp

# ============================================
# 日志和调试配置
# ============================================

LOG_LEVEL=INFO
DEBUG=false

# ============================================
# 缓存配置
# ============================================

CACHE_DIR=/tmp/reports_cache
CACHE_TTL=3600

# ============================================
# 数据库配置（如果使用）
# ============================================

DATABASE_URL=sqlite:///patient_case/skill.db
ENABLE_SQLITE=false

# ============================================
# 应用配置
# ============================================

APP_ENV=production
APP_SECRET_KEY=your-secret-key-change-this-in-production

# ============================================
# 患者报告配置
# ============================================

REPORT_VALIDITY_HOURS=24
REPORT_PASSWORD_LENGTH=12
ENABLE_PDF_EXPORT=false

# ============================================
# 故障转移配置
# ============================================

FALLBACK_STRATEGY=email
ENABLE_LOCAL_FALLBACK=true
